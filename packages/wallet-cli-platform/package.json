{
  "name": "@leashed/wallet-cli-platform",
  "version": "0.0.0",
  "type": "module",
  "description": "Platform commands (agent + marketplace) for the ThaiFi leashed-agent CLI. Mirrors the upstream thaifi-wallet-cli@0.4.0 surface and adds the multi-agent primitive.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@leashed/receipts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace.d.ts",
      "default": "./dist/marketplace.js"
    }
  }
}
