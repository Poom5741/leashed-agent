{
  "name": "@thaifi-wallet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ThaiFi Wallet API: LINE/Email OTP auth, D1 encrypted-key backup, TIDX history proxy",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply thaifi-wallet --local",
    "db:migrate:remote": "wrangler d1 migrations apply thaifi-wallet --remote"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250915.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.104.0"
  }
}
