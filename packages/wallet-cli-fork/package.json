{
  "name": "@leashed/wallet-cli-platform",
  "version": "0.5.0",
  "description": "Leashed Agent Platform CLI — fork of thaifi-wallet-cli. Pair a ThaiFi wallet, deploy AI agents with on-chain leash, register marketplace services, audit receipts.",
  "type": "module",
  "bin": {
    "leashed": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "cli": "tsx src/index.ts"
  },
  "keywords": [
    "leashed-agent",
    "leashed-agent-platform",
    "thaifi",
    "wallet",
    "agent",
    "ai",
    "x402",
    "mpp",
    "tempo",
    "cli",
    "payments",
    "leash",
    "receipts",
    "audit",
    "trust-layer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
